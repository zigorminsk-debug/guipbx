{
  "$schema": "https://html-validate.org/schemas/config.json",
  "root": true,
  "extends": ["html-validate:document"],
  "elements": ["html5"],
  "rules": {
    "no-implicit-button-type": "error",
    "text-content": "error",
    "attr-quotes": ["error", { "style": "double" }],
    "void-style": ["error", { "style": "omit" }],
    "doctype-style": ["error", { "style": "uppercase" }]
  }
}
